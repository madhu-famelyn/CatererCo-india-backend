# --- Database Configuration ---
# Fallback to local SQLite if not defined: sqlite:///./catererco.db
DATABASE_URL=sqlite:///./catererco.db

# --- Security & JWT Token Configuration ---
SECRET_KEY=your-super-secret-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth Configuration ---
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# --- SMTP / Email Configuration ---
# If SMTP_USERNAME is left blank, the app will fall back to using Mock OTP "123456" for verification.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM=team@catererco.com
